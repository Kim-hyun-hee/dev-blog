---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { SERIES, SERIES_IDS, type SeriesId } from "@/series";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSeriesPosts } from "@/utils/getSeriesPosts";
import { postFilter } from "@/utils/postFilter";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (() =>
  SERIES_IDS.map(slug => ({ params: { slug } }))) satisfies GetStaticPaths;

const slug = Astro.params.slug as SeriesId;
const meta = SERIES[slug];

// 최신순이 아니라 편 순서로 정렬한다. 중복 순번이 있으면 예외로 빌드가 선다.
const all = (await getCollection("posts")).filter(postFilter);
const posts = getSeriesPosts(all, slug);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${meta.label} | ${config.site.title}`}>
  <Header barTitle={tplStr(t.bar.series, { name: meta.label })} />
  <Main pageTitle={meta.label} pageDesc={meta.description}>
    <p class="text-muted-foreground -mt-4 mb-8 text-sm">
      {tplStr(t.series.count, { count: posts.length })}
      {" · "}
      {meta.status === "ongoing" ? t.series.ongoing : t.series.completed}
    </p>
    {
      posts.length === 0 ? (
        <p class="text-muted-foreground text-sm">{t.series.empty}</p>
      ) : (
        <ol class="border-border border-t border-dashed">
          {posts.map(post => (
            <li class="border-border border-b border-dashed">
              <a
                href={getPostUrl(post.id, post.filePath, locale)}
                class="hover:bg-accent/10 focus-visible:bg-accent/10 flex items-baseline gap-4 rounded px-2 py-4 transition-colors"
              >
                <span
                  class="text-accent w-7 shrink-0 font-semibold tabular-nums"
                  aria-hidden="true"
                >
                  {String(post.data.seriesOrder).padStart(2, "0")}
                </span>
                <span class="min-w-0">
                  <span class="text-foreground block font-semibold">
                    {post.data.title}
                  </span>
                  <span class="text-muted-foreground mt-1 block text-sm leading-relaxed">
                    {post.data.description}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      )
    }
  </Main>
  <Footer />
</Layout>
