---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
// [CUSTOM] 업스트림에 없는 import 2줄. 홈 상단 두 블록을 별도 컴포넌트로
// 빼둔 것이라, 업스트림이 index.astro를 고쳐도 여기만 유지하면 됩니다.
import HomeHero from "@/components/home/HomeHero.astro";
import HomeSeries from "@/components/home/HomeSeries.astro";

const { posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header barTitle={config.site.title} />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    {
      /* [CUSTOM] 업스트림의 hero 섹션을 이 두 줄이 대체합니다. 원본 hero는
        인사말·테마 홍보 문구·RSS 링크로 이루어져 있었고, 포트폴리오 홈에는
        맞지 않아 걷어냈습니다. 아래 featured / recent-posts 섹션부터는
        업스트림 원본 그대로이니 병합 시 그쪽 변경을 받아들이면 됩니다. */
    }
    <HomeHero />
    <HomeSeries posts={sortedPosts} />

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pt-12 pb-6">
          <h2 class="text-xl font-semibold tracking-wide">{t.home.featured}</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div
      data-all-posts-region
      class="border-border mt-8 flex justify-end border-t pt-4"
    >
      <LinkButton
        data-all-posts
        href={getRelativeLocaleUrl(locale, "posts")}
        variant="quiet"
      >
        {t.home.allPosts}
        <IconArrowRight
          aria-hidden="true"
          class="size-4 rtl:-rotate-180"
          focusable="false"
        />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
