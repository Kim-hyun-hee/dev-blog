---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import ListPagination from "@/components/ListPagination.astro";
import { CATEGORIES, CATEGORY_IDS, type CategoryId } from "@/categories";
import { filterByCategory } from "@/utils/getPostsByCategory";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { listsPostsDirectly } from "@/utils/listsPostsDirectly";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

/**
 * 소분류가 없는 대분류의 페이지네이션 글 목록. 소분류가 있는 대분류는
 * index.astro가 안내한다.
 * 두 파일의 담당이 겹치면 같은 경로가 두 번 생성되어 빌드가 멈춘다.
 */
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = getSortedPosts(await getCollection("posts"));

  return CATEGORY_IDS.filter(listsPostsDirectly).flatMap(category =>
    paginate(filterByCategory(posts, category), {
      params: { category },
      pageSize: config.posts.perPage,
    })
  );
}

const { page } = Astro.props;
const category = Astro.params.category as CategoryId;
const meta = CATEGORIES[category];

const t = useTranslations(Astro.currentLocale ?? config.site.lang);
---

<Layout title={`${meta.label} | ${config.site.title}`}>
  <Header barTitle={tplStr(t.bar.postsIn, { name: meta.label })} />
  <Main isList pageTitle={meta.label} pageDesc={meta.description}>
    <section data-post-list>
      <ul>
        {page.data.map(post => <Card {...post} />)}
      </ul>
    </section>
    <ListPagination {page} />
  </Main>
  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
