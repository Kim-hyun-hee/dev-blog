---
import type { MarkdownHeading } from "astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = { headings: MarkdownHeading[] };

const { headings } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const items = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  /*
    처음부터 보이고, 본문을 따라 올라가다 상단에서 고정되는 목차.
    바깥 컨테이너를 relative 부모(<main>)의 오른쪽 여백(start-full)에 걸어
    본문 높이만큼(inset-y-0) 차지하게 하고, 그 안의 sticky가 따라 올라가다
    top-22 지점에서 멈춘다 — 상단 바 56px 아래에 서야 해서 그만큼 내렸다.
    콘텐츠 폭 계산 없이 본문 오른쪽에 그대로 붙는다.
    가로 공간이 넉넉한 2xl 이상에서만 노출한다.
  */
}
{
  items.length > 1 && (
    <div
      class="absolute inset-y-0 start-full ms-6 hidden 2xl:block"
      data-pagefind-ignore
    >
      <nav
        id="floating-toc"
        aria-label={t.toc.title}
        class="sticky top-22 max-h-[calc(100dvh-7rem)] w-(--toc-width) overflow-y-auto overscroll-contain"
      >
        <p class="text-muted-foreground mb-2 text-xs font-semibold tracking-wide uppercase">
          {t.toc.title}
        </p>
        <ul class="border-border space-y-2 border-s">
          {items.map(h => (
            <li class:list={["text-xs leading-snug", h.depth === 3 && "ps-3"]}>
              <a
                href={`#${h.slug}`}
                data-toc-link={h.slug}
                class="text-muted-foreground hover:text-foreground -ms-px block border-s-2 border-s-transparent ps-3 transition-colors"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<script>
  let cleanup = () => {};

  function initToc() {
    cleanup();

    const toc = document.querySelector<HTMLElement>("#floating-toc");
    if (!toc) return;

    // 헤딩 스크롤 스파이.
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]").forEach(a => {
      links.set(a.dataset.tocLink!, a);
    });

    const targets = [...links.keys()]
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const setActive = (id: string) => {
      links.forEach((a, key) => {
        const on = key === id;
        a.classList.toggle("text-foreground", on);
        a.classList.toggle("font-semibold", on);
        a.classList.toggle("border-s-accent", on);
        a.classList.toggle("border-s-transparent", !on);
        a.classList.toggle("text-muted-foreground", !on);
      });
    };

    const spy = new IntersectionObserver(
      entries => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        // 교차하는 헤딩이 없을 때(긴 절의 중간)는 직전 활성 항목을 유지한다.
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 }
    );
    targets.forEach(el => spy.observe(el));

    cleanup = () => spy.disconnect();
  }

  initToc();
  document.addEventListener("astro:before-swap", () => cleanup());
  document.addEventListener("astro:after-swap", initToc);
</script>
