---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  isList?: boolean;
  class?: string;
};

const { pageTitle, pageDesc, isList = false, class: className } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pt-8 pb-16", className]}
>
  {
    isList ? (
      <header data-list-header class="mb-6">
        <h1 class="text-2xl font-bold sm:text-3xl">{pageTitle}</h1>
        {pageDesc && <p class="mt-2">{pageDesc}</p>}
      </header>
    ) : (
      <>
        <h1 class="text-2xl font-bold sm:text-3xl">{pageTitle}</h1>
        {pageDesc && <p class="mt-2 mb-8">{pageDesc}</p>}
      </>
    )
  }
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
