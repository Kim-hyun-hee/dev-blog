---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPaginationItems, getPageBasePath } from "@/utils/pagination";
import { useTranslations, tplStr } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const base = getPageBasePath(page.url.current, page.currentPage);
const items = getPaginationItems(page.currentPage, page.lastPage);

/** 1페이지는 번호 없는 주소다. */
const urlFor = (n: number) => (n === 1 ? `${base}/` : `${base}/${n}`);

// 이전·다음도 같은 함수로 만든다. page.url.prev 는 끝 슬래시가 없어서
// 그대로 쓰면 한 페이지에 두 가지 주소가 생긴다.
const prevUrl = page.currentPage > 1 ? urlFor(page.currentPage - 1) : null;
const nextUrl =
  page.currentPage < page.lastPage ? urlFor(page.currentPage + 1) : null;

/** 01, 02 … 두 자리로 채운다. */
const pad = (n: number) => String(n).padStart(2, "0");

const cell =
  "grid size-7 place-items-center rounded-md text-xs font-bold transition-colors sm:size-9";
const inactive =
  "text-muted-foreground hover:bg-accent-muted hover:text-accent focus-visible:bg-accent-muted focus-visible:text-accent";
const disabled = "text-muted-foreground opacity-40";
---

{
  page.lastPage > 1 && (
    <nav
      class="flex items-center justify-center gap-1 sm:gap-2"
      aria-label="Pagination Navigation"
    >
      {prevUrl ? (
        <a
          href={prevUrl}
          class:list={[cell, inactive]}
          aria-label={t.a11y.goToPreviousPage}
        >
          <IconArrowLeft class="size-5 rtl:rotate-180" />
        </a>
      ) : (
        <span class:list={[cell, disabled]} aria-hidden="true">
          <IconArrowLeft class="size-5 rtl:rotate-180" />
        </span>
      )}

      {items.map(item =>
        item === "dots" ? (
          <span
            class="text-muted-foreground grid size-7 place-items-center text-xs sm:size-9"
            aria-hidden="true"
          >
            &hellip;
          </span>
        ) : item === page.currentPage ? (
          <span
            class:list={[cell, "bg-accent-muted text-accent"]}
            aria-current="page"
            aria-label={tplStr(t.a11y.paginationCurrent, { page: item })}
          >
            {pad(item)}
          </span>
        ) : (
          <a
            href={urlFor(item)}
            class:list={[cell, inactive]}
            aria-label={tplStr(t.a11y.paginationGoTo, { page: item })}
          >
            {pad(item)}
          </a>
        )
      )}

      {nextUrl ? (
        <a
          href={nextUrl}
          class:list={[cell, inactive]}
          aria-label={t.a11y.goToNextPage}
        >
          <IconArrowRight class="size-5 rtl:rotate-180" />
        </a>
      ) : (
        <span class:list={[cell, disabled]} aria-hidden="true">
          <IconArrowRight class="size-5 rtl:rotate-180" />
        </span>
      )}
    </nav>
  )
}
