---
/**
 * [CUSTOM] 업스트림에 없는 컴포넌트입니다.
 *
 * giscus 댓글이 들어갈 빈 컨테이너. 설정은 data-* 속성으로 실어 보내고, 실제
 * 주입과 테마 동기화는 src/scripts/comments.ts 가 합니다. 왜 스크립트 태그를
 * 여기 직접 두지 않는지도 그 파일에 적혀 있습니다.
 *
 * 설정이 없으면 아무것도 렌더하지 않습니다.
 */
import config from "@/config";
import { useTranslations } from "@/i18n";

const comments = config.comments;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);

// 테마는 프리셋 이름이 아니라 CSS 파일 URL로 넘깁니다(public/giscus/). giscus
// 서버가 읽어가야 하므로 배포처를 가리키는 절대 URL이어야 합니다. 덕분에 개발
// 서버에서도 배포된 테마가 그대로 보입니다 — 대신 테마를 고치면 배포한 뒤에야
// 반영됩니다.
const themeUrl = (name: string) =>
  new URL(`giscus/${name}.css`, config.site.url).href;
---

{
  comments && (
    <section class="mt-10" aria-label={t.comments.title}>
      <div
        id="comments"
        data-repo={comments.repo}
        data-repo-id={comments.repoId}
        data-category={comments.category}
        data-category-id={comments.categoryId}
        data-mapping={comments.mapping}
        data-strict="0"
        data-reactions-enabled={comments.reactionsEnabled ? "1" : "0"}
        data-emit-metadata="0"
        data-input-position="bottom"
        data-lang={comments.lang}
        data-theme-light={themeUrl("light")}
        data-theme-dark={themeUrl("dark")}
      />
    </section>
  )
}
