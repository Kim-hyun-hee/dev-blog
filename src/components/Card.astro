---
import type { CollectionEntry } from "astro:content";
import { CATEGORIES, getSubcategoryLabel } from "@/categories";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3" | "h4";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
const taxonomyLabel = data.category
  ? (data.subcategory &&
      getSubcategoryLabel(data.category, data.subcategory)) ||
    CATEGORIES[data.category].label
  : undefined;
---

<li
  data-post-row
  class:list={[
    "border-b-border grid border-b py-[15px]",
    "first:border-t-accent first:border-t",
    "hover:bg-[linear-gradient(90deg,var(--accent-muted),transparent)]",
    "sm:grid-cols-[4.875rem_minmax(0,1fr)] sm:gap-[13px]",
  ]}
>
  <Datetime {...props} format="compact" class="mb-1 sm:mb-0" />
  <div class="min-w-0">
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      class:list={[
        "text-foreground decoration-accent inline-block text-base leading-[1.35] font-[750] underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      <Heading>{title}</Heading>
    </a>
    {
      taxonomyLabel && (
        <p
          data-post-taxonomy
          class="text-accent mt-0.5 text-[11px] leading-[1.45] font-bold"
        >
          {taxonomyLabel}
        </p>
      )
    }
    <p class="text-foreground/80 mt-1 text-[13px] leading-[1.55]">
      {description}
    </p>
  </div>
</li>
