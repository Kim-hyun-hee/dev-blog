---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Image } from "astro:assets";
import profileImage from "@/assets/images/profile.png";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconRss from "@/assets/icons/IconRss.svg";
import { getCollection } from "astro:content";
import SidebarNav from "./SidebarNav.astro";
import Socials from "@/components/Socials.astro";
import { useTranslations } from "@/i18n";
import { getPathSegments } from "@/utils/withBase";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getCategoryCounts } from "@/utils/getCategoryCounts";
import { getPostUrl } from "@/utils/getPostPaths";
import { resolveActiveTaxonomy } from "@/utils/resolveActiveTaxonomy";
import config from "@/config";

const { site, features } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);
const rssHref = getRelativeLocaleUrl(locale, "rss.xml");

const segments = getPathSegments(Astro.url.pathname, locale);
const activeSegment = segments[0];

const allPosts = getSortedPosts(await getCollection("posts"));
const counts = getCategoryCounts(allPosts);

// 글 페이지는 URL만으로 분류를 알 수 없어 글 목록과 대조한다.
// allPosts는 위에서 카운트 계산용으로 이미 불러온 것이라 추가 조회가 없다.
const active = resolveActiveTaxonomy(
  segments,
  Astro.url.pathname,
  allPosts.map(p => ({
    url: getPostUrl(p.id, p.filePath, locale),
    category: p.data.category,
    subcategory: p.data.subcategory,
  }))
);

// "분류 전체보기"는 글 목록 페이지에서만 강조한다. 개별 글에서는 그 글의
// 분류가 강조되므로 둘이 함께 켜지면 안 된다.
const postsActive = segments[0] === "posts" && active === null;

const utilLinkClass =
  "text-sidebar-link hover:text-foreground focus-outline block rounded px-2 py-1.5 text-sm";
const activeUtilLinkClass = "text-foreground";
---

<aside
  id="site-sidebar"
  aria-label={t.nav.categories}
  class="border-border bg-muted fixed inset-y-0 start-0 z-40 flex w-(--sidebar-width) -translate-x-full flex-col overflow-y-auto border-e px-5 py-7 transition-transform duration-200 lg:translate-x-0 rtl:translate-x-full rtl:lg:translate-x-0"
>
  <div class="profile-ring w-fit rounded-full p-[3px]">
    <Image
      src={profileImage}
      alt=""
      width={128}
      height={128}
      class="block size-16 rounded-full"
    />
  </div>
  <a
    href={getRelativeLocaleUrl(locale, "")}
    class="hover:text-link mt-3 text-lg font-bold transition-colors"
  >
    {site.title}
  </a>
  {
    site.role && (
      <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
        {site.role}
      </p>
    )
  }

  <div class="-ms-2 mt-3">
    <Socials />
  </div>

  {
    /* About은 글 분류가 아니라 프로필의 연장이라 정체성 묶음에 둔다.
      utilLinkClass의 px-2를 -ms-2로 상쇄해 위 텍스트와 좌측을 맞춘다. */
  }
  {
    features.showAbout && (
      <div class="-ms-2 mt-1">
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class:list={[
            utilLinkClass,
            { [activeUtilLinkClass]: activeSegment === "about" },
          ]}
          aria-current={activeSegment === "about" ? "page" : undefined}
        >
          {t.nav.about}
        </a>
      </div>
    )
  }

  <div class="mt-8">
    <SidebarNav
      counts={counts}
      activeCategory={active?.category}
      activeSubcategory={active?.subcategory}
      activeKind={active?.kind ?? "page"}
      postsActive={postsActive}
    />
  </div>

  <div class="border-border mt-8 space-y-0.5 border-t pt-4">
    <a
      href={getRelativeLocaleUrl(locale, "series")}
      class:list={[
        utilLinkClass,
        { [activeUtilLinkClass]: activeSegment === "series" },
      ]}
      aria-current={activeSegment === "series" ? "page" : undefined}
    >
      {t.nav.series}
    </a>
    <a
      href={getRelativeLocaleUrl(locale, "tags")}
      class:list={[
        utilLinkClass,
        { [activeUtilLinkClass]: activeSegment === "tags" },
      ]}
      aria-current={activeSegment === "tags" ? "page" : undefined}
    >
      {t.nav.tags}
    </a>
    {
      features.showArchives && (
        <a
          href={getRelativeLocaleUrl(locale, "archives")}
          class:list={[
            utilLinkClass,
            { [activeUtilLinkClass]: activeSegment === "archives" },
          ]}
          aria-current={activeSegment === "archives" ? "page" : undefined}
        >
          {t.nav.archives}
        </a>
      )
    }
  </div>

  <div class="mt-auto pt-6">
    <div class="flex items-center gap-1">
      {
        features.search !== false && (
          <a
            href={getRelativeLocaleUrl(locale, "search")}
            class="focus-outline text-sidebar-link hover:text-foreground rounded p-2"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="size-5" />
          </a>
        )
      }
      <a
        href={rssHref}
        class="focus-outline text-sidebar-link hover:text-foreground rounded p-2"
        title="RSS"
        aria-label="RSS"
      >
        <IconRss class="size-5" />
      </a>
    </div>
  </div>
</aside>

<button
  id="sidebar-overlay"
  type="button"
  aria-label={t.a11y.closeMenu}
  class="fixed inset-0 z-30 hidden bg-black/40 lg:hidden"></button>
