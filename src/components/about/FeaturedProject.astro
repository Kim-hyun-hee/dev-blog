---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SERIES } from "@/series";
import config from "@/config";

type Props = {
  project: CollectionEntry<"projects">;
  /** 연재가 걸린 프로젝트의 글 수. about.astro가 세어 넘긴다. */
  seriesPostCount?: number;
};

const { project, seriesPostCount = 0 } = Astro.props;
const {
  title,
  summary,
  period,
  role,
  stack,
  repository,
  website,
  order,
  series,
} = project.data;
const headingId = `project-${project.id}`;
const number = String(order).padStart(2, "0");
const locale = Astro.currentLocale ?? config.site.lang;
const detailHref = getRelativeLocaleUrl(locale, `projects/${project.id}`);
---

{
  /* 카드 전체가 상세 페이지로 가되, 안쪽 링크가 따로 살아야 한다. 카드를
    <a>로 감싸면 링크가 중첩되므로 제목 링크의 ::after로 카드를 덮고
    (stretched link) 안쪽 링크는 z-10으로 그 위에 띄운다. */
}
<article
  data-featured-project
  aria-labelledby={headingId}
  class="border-border bg-muted/35 [&:has(a.project-cover:hover)]:border-accent relative flex min-w-0 flex-col rounded-xl border p-5 transition-colors sm:p-6"
>
  <p class="text-accent text-xs font-semibold tracking-[0.16em] uppercase">
    Project {number}
  </p>
  <h3 id={headingId} class="mt-3 text-xl font-semibold sm:text-2xl">
    <a
      href={detailHref}
      class="project-cover after:absolute after:inset-0 after:rounded-xl after:content-['']"
    >
      {title}
    </a>
  </h3>
  <p class="text-muted-foreground mt-3 leading-relaxed">{summary}</p>

  <dl class="border-border mt-5 grid gap-3 border-t pt-4 text-sm">
    <div class="grid gap-1 sm:grid-cols-[4rem_minmax(0,1fr)]">
      <dt class="text-muted-foreground">기간</dt>
      <dd>{period}</dd>
    </div>
    <div class="grid gap-1 sm:grid-cols-[4rem_minmax(0,1fr)]">
      <dt class="text-muted-foreground">역할</dt>
      <dd>{role}</dd>
    </div>
  </dl>

  <ul aria-label={`${title} 기술 스택`} class="mt-5 flex flex-wrap gap-2">
    {
      stack.map(item => (
        <li class="bg-accent-muted text-accent rounded-full px-2.5 py-1 text-xs font-medium">
          {item}
        </li>
      ))
    }
  </ul>

  {
    series && seriesPostCount > 0 && (
      <p class="relative z-10 mt-5">
        <a
          data-project-series-link
          href={getRelativeLocaleUrl(locale, `series/${series}`)}
          aria-label={`${SERIES[series].label} 연재 ${seriesPostCount}편 보기`}
          class="text-accent hover:text-link-hover text-sm font-medium transition-colors"
        >
          관련 글 {seriesPostCount}편 보러가기 →
        </a>
      </p>
    )
  }

  {
    (repository || website) && (
      <div class="relative z-10 mt-5 flex flex-wrap gap-2">
        {repository && (
          <a
            href={repository}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} 저장소 보기`}
            class="border-border hover:border-accent hover:text-accent rounded-md border px-3 py-2 text-sm font-medium transition-colors"
          >
            Repository
          </a>
        )}
        {website && (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${title} 웹사이트 보기`}
            class="border-border hover:border-accent hover:text-accent rounded-md border px-3 py-2 text-sm font-medium transition-colors"
          >
            Website
          </a>
        )}
      </div>
    )
  }
</article>
