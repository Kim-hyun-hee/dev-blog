---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SERIES } from "@/series";
import config from "@/config";

type Props = {
  project: CollectionEntry<"projects">;
  /** 연재가 걸린 프로젝트의 글 수. about.astro가 세어 넘긴다. */
  seriesPostCount?: number;
};

const { project, seriesPostCount = 0 } = Astro.props;
const {
  title,
  summary,
  period,
  role,
  stack,
  repository,
  website,
  order,
  series,
} = project.data;
const headingId = `project-${project.id}`;
const number = String(order).padStart(2, "0");
const locale = Astro.currentLocale ?? config.site.lang;
const detailHref = getRelativeLocaleUrl(locale, `projects/${project.id}`);
---

{/* stretched link 패턴. 자세한 이유는 FeaturedProject.astro 주석 참고. */}
<li
  data-project-row
  aria-labelledby={headingId}
  class="border-border [&:has(a.project-cover:hover)]:bg-muted/40 relative grid min-w-0 gap-3 border-t py-5 transition-colors sm:grid-cols-[2.5rem_minmax(0,1fr)]"
>
  <span
    class="text-accent text-sm font-semibold tabular-nums"
    aria-hidden="true"
  >
    {number}
  </span>
  <div class="min-w-0">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 id={headingId} class="text-base font-semibold">
        <a
          href={detailHref}
          class="project-cover after:absolute after:inset-0 after:content-['']"
        >
          {title}
        </a>
      </h3>
      <span class="text-muted-foreground text-xs">{period}</span>
    </div>
    <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{summary}</p>
    <p class="mt-2 text-xs">
      <span class="text-muted-foreground">{role}</span>
      <span class="text-border mx-2" aria-hidden="true">/</span>
      <span>{stack.join(" · ")}</span>
    </p>
    {
      series && seriesPostCount > 0 && (
        <p class="relative z-10 mt-3 text-sm">
          <a
            data-project-series-link
            href={getRelativeLocaleUrl(locale, `series/${series}`)}
            aria-label={`${SERIES[series].label} 연재 ${seriesPostCount}편 보기`}
            class="text-accent font-medium underline-offset-4 hover:underline"
          >
            관련 글 {seriesPostCount}편 보러가기 →
          </a>
        </p>
      )
    }
    {
      (repository || website) && (
        <div class="relative z-10 mt-3 flex flex-wrap gap-3 text-sm">
          {repository && (
            <a
              href={repository}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${title} 저장소 보기`}
              class="decoration-accent underline-offset-4 hover:underline"
            >
              Repository
            </a>
          )}
          {website && (
            <a
              href={website}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${title} 웹사이트 보기`}
              class="decoration-accent underline-offset-4 hover:underline"
            >
              Website
            </a>
          )}
        </div>
      )
    }
  </div>
</li>
