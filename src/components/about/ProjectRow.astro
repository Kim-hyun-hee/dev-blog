---
import type { CollectionEntry } from "astro:content";

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { title, summary, period, role, stack, repository, website, order } =
  project.data;
const headingId = `project-${project.id}`;
const number = String(order).padStart(2, "0");
---

<li
  data-project-row
  aria-labelledby={headingId}
  class="border-border grid min-w-0 gap-3 border-t py-5 sm:grid-cols-[2.5rem_minmax(0,1fr)]"
>
  <span
    class="text-accent text-sm font-semibold tabular-nums"
    aria-hidden="true"
  >
    {number}
  </span>
  <div class="min-w-0">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 id={headingId} class="text-base font-semibold">{title}</h3>
      <span class="text-muted-foreground text-xs">{period}</span>
    </div>
    <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{summary}</p>
    <p class="mt-2 text-xs">
      <span class="text-muted-foreground">{role}</span>
      <span class="text-border mx-2" aria-hidden="true">/</span>
      <span>{stack.join(" · ")}</span>
    </p>
    {
      (repository || website) && (
        <div class="mt-3 flex flex-wrap gap-3 text-sm">
          {repository && (
            <a
              href={repository}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${title} GitHub 저장소 보기`}
              class="decoration-accent underline-offset-4 hover:underline"
            >
              GitHub
            </a>
          )}
          {website && (
            <a
              href={website}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${title} 웹사이트 보기`}
              class="decoration-accent underline-offset-4 hover:underline"
            >
              Website
            </a>
          )}
        </div>
      )
    }
  </div>
</li>
