---
/**
 * [CUSTOM] 업스트림에 없는 파일 — 이 저장소에서 추가했습니다.
 *
 * 홈의 대표 시리즈 카드 목록. 시리즈가 하나도 없으면 아무것도 렌더하지
 * 않으므로 index.astro 쪽에 조건 분기를 둘 필요가 없습니다.
 *
 * 편 수 계산에 쓰는 posts는 호출부에서 받습니다. 여기서 getCollection을
 * 다시 부르면 같은 페이지에서 컬렉션을 두 번 읽게 되기 때문입니다.
 */
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { SERIES, SERIES_IDS } from "@/series";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSeriesPosts } from "@/utils/getSeriesPosts";
import { useTranslations, tplStr } from "@/i18n";
import config from "@/config";

type Props = {
  /** draft·예약 글이 이미 걸러진 목록이어야 합니다. */
  posts: CollectionEntry<"posts">[];
};

const { posts } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// getSeriesPosts는 같은 시리즈에 중복된 seriesOrder가 있으면 예외를 던져
// 빌드를 세웁니다. 잡지 마세요 — 그게 이 함수의 역할입니다.
const seriesList = SERIES_IDS.map(id => ({
  id,
  ...SERIES[id],
  posts: getSeriesPosts(posts, id),
}));
---

{
  seriesList.length > 0 && (
    <section class="border-border border-b pt-10 pb-8">
      <h2 class="text-xl font-semibold tracking-wide">{t.series.title}</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {seriesList.map(s => (
          <li class="border-border rounded-lg border p-4">
            <a
              href={getRelativeLocaleUrl(locale, `series/${s.id}`)}
              class="text-foreground font-semibold underline-offset-4 hover:underline"
            >
              {s.label}
            </a>
            <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
              {s.description}
            </p>
            {s.posts.length > 0 && (
              <ol class="border-border mt-4 space-y-1 border-t border-dashed pt-3">
                {s.posts.slice(0, 2).map(post => (
                  <li>
                    <a
                      href={getPostUrl(post.id, post.filePath, locale)}
                      class="hover:bg-accent/10 focus-visible:bg-accent/10 flex items-baseline gap-2 rounded px-1 py-1.5 text-sm transition-colors"
                    >
                      <span
                        class="text-accent w-5 shrink-0 font-semibold tabular-nums"
                        aria-hidden="true"
                      >
                        {String(post.data.seriesOrder).padStart(2, "0")}
                      </span>
                      <span class="truncate">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ol>
            )}
            <p class="text-muted-foreground mt-3 text-sm">
              {tplStr(t.series.count, { count: s.posts.length })}
              {" · "}
              {s.status === "ongoing" ? t.series.ongoing : t.series.completed}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}
