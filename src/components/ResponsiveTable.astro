---
type Props = {
  class?: string;
  variant?:
    /** Removes internal row rules. */
    | "minimal"
    /** Alternating body rows are tinted. */
    | "striped"
    /** Alternating body rows are tinted without internal row rules. */
    | "striped-minimal";
};

const { class: className, variant } = Astro.props;

const variantClasses = {
  striped: "[&_tbody_tr]:odd:bg-muted/25",
};
---

<div
  data-responsive-table
  data-table-variant={variant}
  class:list={[
    "overflow-hidden [&_table]:my-0 [&_table]:min-w-xl",
    variant === "striped" && variantClasses.striped,
    variant === "striped-minimal" && variantClasses.striped,
    className,
  ]}
>
  <div class="relative w-full overflow-x-auto">
    <slot />
  </div>
</div>
